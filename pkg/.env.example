DOMAIN_NAME=<domain name>

POSTGRES_PASSWD=<password>
POSTGRES_USER=<user>
POSTGRES_PROD=<prod/dev/test>
POSTGRES_PORT=<port>
POSTGRES_DSN=postgres://<user>:<password>@<host>:<port>

GOOSE_DRIVER=<driver>
GOOSE_DBSTRING=<postgres://<user>:<password>@<host>:<port>
GOOSE_MIGRATION_DIR=<path to migrations>

SWAGGER_HOST=<host>:<port>

SMTP_HOST=<host>
SMTP_PORT=<port>
SMTP_USER=<user>
SMTP_PASSWORD=<password>
SMTP_WEBUI_PORT=<port>
SMTP_FROM=<email@domain.com>

JWT_SECRET=<hash key>
JWT_TTL=<time h>
COOKIE_SECURE=<bool>

IP_HASH_KEY=<hash key>